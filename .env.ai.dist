# Configuration IA - Outil perso d'aide à candidater
# IA_ALBERT=TRUE priorise l'API Albert. Mets-le à TRUE si tu veux utiliser Albert en priorité.
IA_ALBERT=FALSE

# Provider par défaut si IA_ALBERT=FALSE ou pour forcer : auto|albert|openai|claude|gemini
AI_PROVIDER=auto

# Forcer un modèle spécifique (laisser vide pour utiliser le modèle par défaut du provider)
AI_MODEL=

# API Albert (https://api.albert.etalab.gouv.fr/) - prioritaire si IA_ALBERT=TRUE
ALBERT_API_KEY=
ALBERT_BASE_URL=https://api.albert.etalab.gouv.fr/v1
ALBERT_MODEL=albert-large

# OpenAI / OpenAI-compatible (ex: OpenRouter, Groq, LMDeploy, vLLM, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_NAME=openai

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
