{% extends 'base.html.twig' %}
{% set active = 'candidatures' %}
{% set activeSection = 'spontanees' %}

{% block title %}{{ mode == 'new' ? 'Nouvelle société' : 'Modifier la société' }} — JobPilot{% endblock %}

{% block styles %}
.layout { display: grid; grid-template-columns: 1fr .55fr; gap: 22px; align-items: start; }
@media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }
.tip { font-size: 14px; line-height: 1.8; color: var(--text-2); }
.tip b { color: var(--accent); }
.form-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
.danger-zone { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
{% endblock %}

{% block body %}
<div class="page-head">
    <span class="eyebrow">🤝 {{ mode == 'new' ? 'NOUVELLE SOCIÉTÉ' : 'FICHE SOCIÉTÉ' }}</span>
    <h1>{{ mode == 'new' ? 'Ajouter une société à démarcher' : item.nom_societe }}</h1>
    <p class="muted">
        <a href="{{ path('app_spontaneous_index') }}">← Retour aux candidatures spontanées</a>
    </p>
</div>

{% include 'candidature/_tabs.html.twig' %}

<div class="layout">
    <div>
        <form class="card" method="post">
            <div class="grid-2" style="margin-bottom:4px">
                <div class="form-group">
                    <label for="nom_societe">Nom de la société *</label>
                    <input type="text" id="nom_societe" name="nom_societe" required
                           value="{{ item.nom_societe ?? '' }}" placeholder="Ex : ACME">
                    {% if erreurs.nom_societe is defined %}<div class="form-error">{{ erreurs.nom_societe }}</div>{% endif %}
                </div>
                <div class="form-group">
                    <label for="contact">Contact (nom du recruteur)</label>
                    <input type="text" id="contact" name="contact"
                           value="{{ item.contact ?? '' }}" placeholder="Ex : Marie Dupont">
                </div>
            </div>

            <div class="grid-2" style="margin-bottom:4px">
                <div class="form-group">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="email"
                           value="{{ item.email ?? '' }}" placeholder="contact@societe.fr">
                    {% if erreurs.email is defined %}<div class="form-error">{{ erreurs.email }}</div>{% endif %}
                </div>
                <div class="form-group">
                    <label for="telephone">Téléphone</label>
                    <input type="tel" id="telephone" name="telephone"
                           value="{{ item.telephone ?? '' }}" placeholder="01 23 45 67 89">
                </div>
            </div>

            <div class="grid-2" style="margin-bottom:4px">
                <div class="form-group">
                    <label for="ville">Ville</label>
                    <input type="text" id="ville" name="ville"
                           value="{{ item.ville ?? '' }}" placeholder="Lyon">
                </div>
                <div class="form-group">
                    <label for="secteur">Secteur d’activité</label>
                    <input type="text" id="secteur" name="secteur"
                           value="{{ item.secteur ?? '' }}" placeholder="Industrie, conseil, santé…">
                </div>
            </div>

            <div class="grid-2" style="margin-bottom:4px">
                <div class="form-group">
                    <label for="site_web">Site web</label>
                    <input type="text" id="site_web" name="site_web"
                           value="{{ item.site_web ?? '' }}" placeholder="https://…">
                </div>
                <div class="form-group">
                    <label for="poste">Poste / domaine visé</label>
                    <input type="text" id="poste" name="poste"
                           value="{{ item.poste ?? '' }}" placeholder="Développeur PHP / Symfony">
                </div>
            </div>

            <div class="grid-2" style="margin-bottom:4px">
                <div class="form-group">
                    <label for="date_envoi">Date d’envoi</label>
                    <input type="date" id="date_envoi" name="date_envoi" value="{{ item.date_envoi ?? '' }}">
                    <div class="form-help">Le statut ci-dessous fait foi. « À envoyer » vide automatiquement la date d’envoi.</div>
                    {% if erreurs.date_envoi is defined %}<div class="form-error">{{ erreurs.date_envoi }}</div>{% endif %}
                </div>
                <div class="form-group">
                    <label for="reponse">Statut du suivi</label>
                    <select id="reponse" name="reponse">
                        {% for code, meta in statuses %}
                            <option value="{{ code }}" {{ (item.reponse ?? '') == code ? 'selected' }}>{{ meta.icon }} {{ meta.label }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-help">Ce statut est l’état unique de la candidature, utilisé pour les filtres et les statistiques.</div>
                </div>
            </div>

            <div class="form-group" id="date-reponse-group">
                <label for="date_reponse">Date de la réponse</label>
                <input type="date" id="date_reponse" name="date_reponse" value="{{ item.date_reponse ?? '' }}">
                <div class="form-help">Renseignée automatiquement si vous sélectionnez une réponse positive ou négative.</div>
                {% if erreurs.date_reponse is defined %}<div class="form-error">{{ erreurs.date_reponse }}</div>{% endif %}
            </div>

            <div class="form-group">
                <label for="notes">Notes</label>
                <textarea id="notes" name="notes" placeholder="Historique des échanges, nom de la personne rencontrée, points d’attention…">{{ item.notes ?? '' }}</textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    {{ mode == 'new' ? '＋ Ajouter la société' : '💾 Enregistrer' }}
                </button>
                <a class="btn btn-ghost" href="{{ path('app_spontaneous_index') }}">Annuler</a>
                {% if mode == 'edit' %}
                    <a class="btn btn-ghost" href="{{ path('app_spontaneous_letter', {id: item.id}) }}">
                        ✍️ {{ item.lettre_texte is defined and item.lettre_texte ? 'Voir la lettre' : 'Générer une lettre' }}
                    </a>
                {% endif %}
            </div>
        </form>

        {% if mode == 'edit' %}
            <div class="danger-zone">
                <form method="post" action="{{ path('app_spontaneous_delete', {id: item.id}) }}"
                      onsubmit="return confirm('Supprimer définitivement cette société et sa lettre ?')">
                    <button type="submit" class="btn btn-danger btn-sm">🗑️ Supprimer cette société</button>
                </form>
            </div>
        {% endif %}
    </div>

    <aside class="card tip">
        <h2 style="font-size:17px">💡 Suivi et lettre</h2>
        <p>
            Une fois la fiche créée, utilisez <b>Générer une lettre</b> : l’IA rédige une
            candidature spontanée à partir de votre CV, sans inventer d’expérience.
        </p>
        <p>
            Pour aller plus vite, importez plusieurs sociétés d’un coup depuis le tableau
            de bord avec un fichier CSV.
        </p>
        <a class="btn btn-ghost btn-sm" href="{{ path('app_spontaneous_index') }}">← Tableau de bord</a>
    </aside>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var select = document.getElementById('reponse');
        var group = document.getElementById('date-reponse-group');
        var input = document.getElementById('date_reponse');

        if (!select || !group || !input) {
            return;
        }

        var sync = function () {
            var withAnswer = ['reponse_positive', 'reponse_negative'].indexOf(select.value) !== -1;
            input.disabled = !withAnswer;
            group.style.opacity = withAnswer ? '1' : '.55';
        };

        select.addEventListener('change', sync);
        sync();
    });
</script>
{% endblock %}
