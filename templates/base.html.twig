<!DOCTYPE html>
<html lang="fr" data-theme="">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}JobPilot{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧭</text></svg>">
    <script>
        (function () {
            var saved = null;
            try { saved = localStorage.getItem('jobpilot-theme'); } catch (e) {}
            var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <style>
        {% include 'partials/styles.html.twig' %}
        {% block styles %}{% endblock %}
    </style>
    {% block javascripts %}
    {% endblock %}
</head>
<body>
    <header class="app-nav">
        <a class="brand" href="{{ path('app_home') }}">Job<span>Pilot</span></a>
        <div class="nav-right">
            <nav class="nav-links" aria-label="Navigation principale">
                <a href="{{ path('app_home') }}" class="{{ active == 'home' ? 'active' }}">Accueil</a>
                <a href="{{ path('app_assistant') }}" class="{{ active == 'assistant' ? 'active' }}">CV ↔ Offre</a>
                <a href="{{ path('app_offer_analyser') }}" class="{{ active == 'offres' ? 'active' }}">Analyser offre</a>
                <a href="{{ path('app_interview') }}" class="{{ active == 'entretien' ? 'active' }}">Entretien</a>
                <a href="{{ path('app_cv_analyser') }}" class="{{ active == 'cv' ? 'active' }}">Mon CV</a>
                <a href="{{ path('app_candidature_index') }}" class="{{ active == 'candidatures' ? 'active' }}">Candidatures</a>
            </nav>
            <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Basculer le thème" title="Basculer clair / sombre">
                <span id="theme-icon">🌙</span>
            </button>
        </div>
    </header>

    <main class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

    {% block body %}{% endblock %}
    </main>

    <footer class="footer">© {{ "now"|date("Y") }} JobPilot · Outil perso d'aide à candidater</footer>

    <script>
        (function () {
            var toggle = document.getElementById('theme-toggle');
            var icon = document.getElementById('theme-icon');
            if (!toggle) return;

            var updateIcon = function (theme) {
                icon.textContent = theme === 'dark' ? '☀️' : '🌙';
            };
            updateIcon(document.documentElement.getAttribute('data-theme'));

            toggle.addEventListener('click', function () {
                var current = document.documentElement.getAttribute('data-theme');
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                try { localStorage.setItem('jobpilot-theme', next); } catch (e) {}
                updateIcon(next);
            });
        })();
    </script>

    <script>
        (function () {
            var overlay = null;
            var messageEl = null;

            function getOverlay() {
                if (overlay) return overlay;

                overlay = document.createElement('div');
                overlay.className = 'ai-overlay';
                overlay.setAttribute('role', 'status');
                overlay.setAttribute('aria-live', 'polite');
                overlay.hidden = true;

                var card = document.createElement('div');
                card.className = 'ai-loader-card';

                var spinner = document.createElement('div');
                spinner.className = 'spinner';

                messageEl = document.createElement('strong');
                messageEl.textContent = 'Traitement en cours…';

                var hint = document.createElement('p');
                hint.textContent = 'Cela peut prendre quelques secondes, merci de patienter.';

                card.appendChild(spinner);
                card.appendChild(messageEl);
                card.appendChild(hint);
                overlay.appendChild(card);
                document.body.appendChild(overlay);

                return overlay;
            }

            document.addEventListener('submit', function (event) {
                var form = event.target;

                if (!form || form.tagName !== 'FORM') {
                    return;
                }

                var submitter = event.submitter || null;
                var message = submitter && submitter.dataset ? submitter.dataset.aiLoading : null;

                if (!message && form.dataset) {
                    message = form.dataset.aiLoading;
                }

                if (!message) {
                    return;
                }

                var node = getOverlay();
                messageEl.textContent = message;
                node.hidden = false;
            });

            window.addEventListener('pageshow', function () {
                if (overlay) {
                    overlay.hidden = true;
                }
            });
        })();
    </script>
</body>
</html>
